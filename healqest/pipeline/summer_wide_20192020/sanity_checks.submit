#!/bin/bash
#SBATCH --partition=sapphire
#SBATCH --account="punim1922"
#SBATCH --output=batch_jobs_sanity_checks/job.o%j
#SBATCH --time 6:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBTACH --cpus-per-task=4
#SBATCH --mem=10GB
#SBATCH --job-name=sanity_checks


nsims=10
nber_bundles=10

yaml=yaml/sqe/config_sqe_030425_sims_summer-a_full_lminT500_lmaxT3500_mmin100.yaml
